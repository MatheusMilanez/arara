{
  "name": "arara",
  "version": "0.1.0",
  "description": "ARARA — indexação distribuída de dados públicos brasileiros",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "migrate:up": "tsx src/database/migrations.ts up",
    "migrate:down": "tsx src/database/migrations.ts down",
    "migrate:create": "tsx src/database/migrations.ts create",
    "ingest:ibge": "tsx src/services/ingester/datasources/ibgeMunicipios.ts",
    "ingest:tse": "tsx src/services/ingester/datasources/tseCandidatos.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "testcontainers": "^10.28.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
